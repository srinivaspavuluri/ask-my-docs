    {
      "id": "q08",
      "category": "section",
      "question": "Customers say checkout is slow. p95 latency has been around 900 ms for the last ten minutes. What should I look at first?",
      "answerable": true,
      "expected_source": "custom/PaymentsApiHighLatency.md",
      "expected_section": "Diagnosis",
      "must_contain": [
        "Payments / Latency"
      ]
