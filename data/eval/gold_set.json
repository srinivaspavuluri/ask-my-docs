{
  "version": 1,
  "description": "Gold set for Ask My Docs (runbook assistant). expected_source = documents.source; must_contain = case-insensitive substrings that a correct answer must include and that are not in the question.",
  "questions": [
    {
      "id": "q01",
      "category": "exact_identifier",
      "question": "Checkout requests are timing out and the DB dashboard shows 40/40 connections. What's happening?",
      "answerable": true,
      "expected_source": "custom/PaymentsApiDbPoolExhausted.md",
      "expected_section": "Meaning",
      "must_contain": [
        "DB_POOL_MAX"
      ]
    },
    {
      "id": "q02",
      "category": "exact_identifier",
      "question": "Checkout is timing out because the connection pool is full. Can I just raise the pool size to 100?",
      "answerable": true,
      "expected_source": "custom/PaymentsApiDbPoolExhausted.md",
      "expected_section": "Mitigation",
      "must_contain": [
        "60"
      ]
    },
    {
      "id": "q03",
      "category": "exact_identifier",
      "question": "Checkout started returning 502s right after we deployed payments-api. How do I undo the deploy?",
      "answerable": true,
      "expected_source": "custom/PaymentsApi5xxAfterDeploy.md",
      "expected_section": "Mitigation",
      "must_contain": [
        "rollout undo"
      ]
    },
    {
      "id": "q04",
      "category": "exact_identifier",
      "question": "The new payments-api pods after the deploy never become ready. Which port does their readiness probe use?",
      "answerable": true,
      "expected_source": "custom/PaymentsApi5xxAfterDeploy.md",
      "expected_section": "Diagnosis",
      "must_contain": [
        "8443"
      ]
    },
    {
      "id": "q05",
      "category": "exact_identifier",
      "question": "I just rolled back payments-api after a bad deploy. Is there anything else I'm supposed to do?",
      "answerable": true,
      "expected_source": "custom/PaymentsApi5xxAfterDeploy.md",
      "expected_section": "Mitigation",
      "must_contain": [
        "#payments-oncall"
      ]
    },
    {
      "id": "q06",
      "category": "exact_identifier",
      "question": "Our payments-api error rate is still above 2% ten minutes after I rolled back. Who do I contact?",
      "answerable": true,
      "expected_source": "custom/PaymentsApi5xxAfterDeploy.md",
      "expected_section": "Mitigation",
      "must_contain": [
        "payments team lead"
      ]
    },
    {
      "id": "q07",
      "category": "exact_identifier",
      "question": "The card provider seems slow and only the /v1/charge endpoint is affected. Is there a quick way to keep checkout working?",
      "answerable": true,
      "expected_source": "custom/PaymentsApiHighLatency.md",
      "expected_section": "Mitigation",
      "must_contain": [
        "payments.fallback_provider"
      ]
